{
  "schema": "execution-conformance-v1",
  "name": "trigger-oco-levels",
  "description": "Manual stop + take in one OCO program: the first leg to fire cancels the other level.",
  "covers": [
    "trigger",
    "oco"
  ],
  "steps": [
    {
      "event": {
        "type": "connection",
        "ts": 1000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1001,
        "id": "c1001",
        "command": {
          "op": "create",
          "program": {
            "id": "t2",
            "kind": "trigger",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": true,
            "levels": [
              {
                "id": "S",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 95,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              },
              {
                "id": "T",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "above",
                  "price": 110,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": null,
            "cycle": {
              "rearmAfterExit": false,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1002,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 110
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "t2/T/entry/0/0",
            "action": "Sell",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": null
          }
        ],
        "programs": {
          "t2": {
            "levels": {
              "S": {
                "phase": "done",
                "detail": "ocoCancelled"
              },
              "T": {
                "phase": "working"
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1003,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 90
      }
    }
  ]
}
