{
  "schema": "execution-conformance-v1",
  "name": "restore-past-needs-confirm-keep",
  "description": "#144: after restart the first tick already past holds the trigger; keep arms it only after a recross.",
  "covers": [
    "#144",
    "restart"
  ],
  "steps": [
    {
      "event": {
        "type": "connection",
        "ts": 1000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1001,
        "id": "c1001",
        "command": {
          "op": "create",
          "program": {
            "id": "t1",
            "kind": "trigger",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 100,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": null,
            "cycle": {
              "rearmAfterExit": false,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1002,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 105
      }
    },
    {
      "restart": {
        "ts": 5000
      },
      "expect": {
        "programs": {
          "t1": {
            "hold": "disconnected",
            "levels": {
              "L1": {
                "phase": "idle",
                "check": "restart"
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5001,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 90
      },
      "expect": {
        "programs": {
          "t1": {
            "hold": "disconnected"
          }
        }
      }
    },
    {
      "event": {
        "type": "connection",
        "ts": 5002,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5003,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 98
      },
      "expect": {
        "notices": [
          "needsConfirm"
        ],
        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "phase": "needsConfirm",
                "check": null,
                "pending": {
                  "leg": "entry",
                  "price": 98,
                  "reason": "restart"
                }
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5004,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 97
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 5005,
        "id": "c5005",
        "command": {
          "op": "resolvePending",
          "programId": "t1",
          "version": 1,
          "levelId": "L1",
          "choice": "keep"
        }
      },
      "expect": {
        "programs": {
          "t1": {
            "version": 2,
            "levels": {
              "L1": {
                "phase": "idle",
                "recross": [
                  "entry"
                ],
                "pending": null
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5006,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 96
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5007,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 101
      },
      "expect": {
        "programs": {
          "t1": {
            "levels": {
              "L1": {
                "recross": []
              }
            }
          }
        }
      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 5008,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 100
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "t1/L1/entry/0/0",
            "action": "Sell",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": null,
            "version": 2
          }
        ]
      }
    }
  ]
}
