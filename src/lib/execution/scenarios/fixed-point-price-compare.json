      }
    },
    {
      "event": {
        "type": "tick",
        "ts": 1004,
        "env": "simulation",
        "serverId": "local-a",
        "code": "TXFR1",
        "price": 0.3
      },
      "expect": {
        "intents": [
          {
            "kind": "place",
            "key": "simulation/local-a/a/L1/entry/0/0",
            "action": "Buy",
            "qty": 1,
            "leg": "entry",
            "role": "entry",
            "price": null
          }
        ]
      }
