{
  "schema": "execution-conformance-v1",
  "name": "fixed-point-price-compare",
  "description": "P2-2 / Q1: prices compare as 1e-4 fixed point: a trigger at 0.1 + 0.2 fires on a 0.3 quote in both directions.",
  "covers": [
    "price"
  ],
  "steps": [
    {
      "event": {
        "type": "connection",
        "ts": 1000,
        "live": true,
        "env": "simulation",
        "serverId": "local-a"
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1001,
        "id": "c1001",
        "command": {
          "op": "create",
          "program": {
            "id": "a",
            "kind": "trigger",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Buy",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "above",
                  "price": 0.30000000000000004,
                  "order": {
                    "priceType": "MKT",
                    "timeInForce": "IOC",
                    "octype": "Auto"
                  }
                },
                "exit": null,
                "phase": "idle",
                "check": null,
                "recross": [],
                "pending": null,
                "orders": [],
                "position": 0,
                "entryFilled": 0,
                "unprotected": 0,
                "cycles": 0,
                "detail": null
              }
            ],
            "generator": null,
            "cycle": {
              "rearmAfterExit": false,
              "maxCycles": null,
              "partialFill": "immediate"
            },
            "bounds": {
              "upper": null,
              "lower": null,
              "onBreakUpper": "none",
              "onBreakLower": "none"
            },
            "session": {
              "resumeRule": "confirm",
              "longDisconnectMs": 60000,
              "silentStallMs": 90000
            },
            "risk": {
              "maxWorkingEntries": null
            },
            "hooks": [],
            "intentSeq": 0,
            "issues": [],
            "createdAt": 0,
            "updatedAt": 0
          }
        }
      }
    },
    {
      "event": {
        "type": "command",
        "ts": 1002,
        "id": "c1002",
        "command": {
          "op": "create",
          "program": {
            "id": "b",
            "kind": "trigger",
            "binding": {
              "env": "simulation",
              "serverId": "local-a",
              "account": {
                "accountType": "F",
                "brokerId": "F002000",
                "accountId": "1234567"
              },
              "contract": {
                "market": "futures",
                "quoteCode": "TXFR1",
                "orderCode": "TXFJ6",
                "securityType": "FUT"
              }
            },
            "version": 1,
            "status": "running",
            "pauseReason": null,
            "hold": null,
            "ocoLevels": false,
            "levels": [
              {
                "id": "L1",
                "side": "Sell",
                "qty": 1,
                "entry": {
                  "type": "touch",
                  "condition": "below",
                  "price": 0.3,
                  "order": {
                    "priceType": "MKT",
