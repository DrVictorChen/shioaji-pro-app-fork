  "reports": [
    {
      "name": "a successful Cancel closes the entry",
      "steps": [
        {
          "op": "Cancel",
          "opCode": "00"
        }
      ],
      "expect": {
        "closed": true,
        "protected": 0,
        "unprotected": 0
      }
    },
    {
      "name": "a failed Cancel leaves it open",
      "steps": [
        {
          "op": "Cancel",
          "opCode": "88"
        }
      ],
      "expect": {
        "closed": false,
        "protected": 0,
        "unprotected": 0
      }
    },
    {
      "name": "a Cancel without op_code is no evidence",
      "steps": [
        {
          "op": "Cancel",
          "opCode": ""
        }
      ],
      "expect": {
        "closed": false,
        "protected": 0,
        "unprotected": 0
      }
    },
    {
